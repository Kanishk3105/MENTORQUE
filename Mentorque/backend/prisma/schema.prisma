generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MENTOR
  ADMIN
}

enum WeekFillStatus {
  MATERIALIZED
  CLEARED
  MANUAL
}

// Extensible: new call types can be seeded without a code change.
enum CallTypeKey {
  RESUME_REVAMP
  JOB_MARKET_GUIDANCE
  MOCK_INTERVIEW
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  timezone  String   @default("UTC")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // --- Profile (admin-managed per assignment brief) ---
  description   String? @db.Text // free-text bio used for matching
  location      String?
  company       String? // e.g. "Google", "Independent"
  isBigTech     Boolean @default(false)
  domain        String? // e.g. "Frontend", "Data Science", "Product"
  yearsExperience Int?
  communicationScore Int?  // 0-100, mentor only
  // Cached embedding of `description` for vectorless semantic search.
  // Stored as a plain float array (JSON) so this works without the pgvector
  // extension; if pgvector is available on the Postgres instance this can be
  // swapped for a native `vector` column with no change to calling code.
  embedding     Json?
  embeddingModel String?

  tags Tag[] @relation("UserTags")

  availabilityAsUser     Availability[]          @relation("UserAvailability")
  availabilityAsMentor   Availability[]          @relation("MentorAvailability")
  availabilityTemplate   AvailabilityTemplate?   @relation("UserTemplate")
  mentorTemplate         AvailabilityTemplate?   @relation("MentorTemplate")
  availabilityExceptions AvailabilityException[] @relation("UserExceptions")
  mentorExceptions       AvailabilityException[] @relation("MentorExceptions")
  availabilityWeekMeta   AvailabilityWeekMeta[]  @relation("UserWeekMeta")
  mentorWeekMeta         AvailabilityWeekMeta[]  @relation("MentorWeekMeta")

  meetingsAsAdmin    Meeting[]        @relation("AdminMeetings")
  meetingsAsUser     Meeting[]        @relation("UserMeetings")
  meetingsAsMentor   Meeting[]        @relation("MentorMeetings")
  recommendationsFor Recommendation[] @relation("RecommendationUser")

  @@index([role])
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String? // e.g. "domain", "trait", "company-tier" — free-form grouping for the admin UI
  createdAt DateTime @default(now()) @map("created_at")

  users User[] @relation("UserTags")

  @@map("tags")
}

model CallType {
  id          String      @id @default(uuid())
  key         CallTypeKey @unique
  label       String
  description String?
  // Weights used by the recommendation engine when scoring mentors for this
  // call type (0-1). Editable so new call types can define their own
  // priorities without a code change.
  weights     Json        @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at")

  recommendations Recommendation[]

  @@map("call_types")
}

model Recommendation {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  callTypeId String   @map("call_type_id")
  // Ranked results: [{ mentorId, name, score, confidence, reasoning }]
  results    Json
  model      String? // which LLM/embedding pipeline produced this
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation("RecommendationUser", fields: [userId], references: [id], onDelete: Cascade)
  callType CallType @relation(fields: [callTypeId], references: [id])

  @@index([userId])
  @@map("recommendations")
}

model Availability {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  mentorId  String?  @map("mentor_id")
  role      Role
  date      DateTime @db.Date
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")

  user   User? @relation("UserAvailability", fields: [userId], references: [id], onDelete: Cascade)
  mentor User? @relation("MentorAvailability", fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([userId, date, startTime], map: "availabilities_user_id_date_start_time_key")
  @@unique([mentorId, date, startTime], map: "availabilities_mentor_id_date_start_time_key")
  @@index([userId], map: "availabilities_user_id_idx")
  @@index([mentorId], map: "availabilities_mentor_id_idx")
  @@index([role], map: "availabilities_role_idx")
  @@index([date], map: "availabilities_date_idx")
  @@index([userId, date], map: "availabilities_user_id_date_idx")
  @@index([mentorId, date], map: "availabilities_mentor_id_date_idx")
  @@index([role, date], map: "availabilities_role_date_idx")
  @@map("availabilities")
}

model AvailabilityTemplate {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  mentorId  String?  @unique @map("mentor_id")
  role      Role
  slots     Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User? @relation("UserTemplate", fields: [userId], references: [id], onDelete: Cascade)
  mentor User? @relation("MentorTemplate", fields: [mentorId], references: [id], onDelete: Cascade)

  @@map("availability_templates")
}

model AvailabilityException {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  mentorId  String?  @map("mentor_id")
  role      Role
  weekStart DateTime @map("week_start") @db.Date
  dayOfWeek Int      @map("day_of_week")
  hour      Int
  enabled   Boolean
  createdAt DateTime @default(now()) @map("created_at")

  user   User? @relation("UserExceptions", fields: [userId], references: [id], onDelete: Cascade)
  mentor User? @relation("MentorExceptions", fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart, dayOfWeek, hour], map: "availability_exceptions_user_week_slot_key")
  @@unique([mentorId, weekStart, dayOfWeek, hour], map: "availability_exceptions_mentor_week_slot_key")
  @@map("availability_exceptions")
}

model AvailabilityWeekMeta {
  id        String         @id @default(uuid())
  userId    String?        @map("user_id")
  mentorId  String?        @map("mentor_id")
  role      Role
  weekStart DateTime       @db.Date @map("week_start")
  status    WeekFillStatus
  updatedAt DateTime       @updatedAt @map("updated_at")

  user   User? @relation("UserWeekMeta", fields: [userId], references: [id], onDelete: Cascade)
  mentor User? @relation("MentorWeekMeta", fields: [mentorId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart], map: "availability_week_meta_user_week_key")
  @@unique([mentorId, weekStart], map: "availability_week_meta_mentor_week_key")
  @@map("availability_week_meta")
}

enum MeetingStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  RESCHEDULED
}

model Meeting {
  id           String        @id @default(uuid())
  adminId      String        @map("admin_id")
  userId       String?       @map("user_id")
  mentorId     String?       @map("mentor_id")
  callTypeKey  CallTypeKey?  @map("call_type_key")
  title        String
  startTime    DateTime      @map("start_time")
  endTime      DateTime      @map("end_time")
  status       MeetingStatus @default(SCHEDULED)
  // Free-text meeting link the admin pastes in (Zoom/Meet/etc). No calendar
  // integration — kept intentionally simple per the assignment brief.
  meetingLink  String?       @map("meeting_link")
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  admin        User                 @relation("AdminMeetings", fields: [adminId], references: [id], onDelete: Cascade)
  user         User?                @relation("UserMeetings", fields: [userId], references: [id], onDelete: SetNull)
  mentor       User?                @relation("MentorMeetings", fields: [mentorId], references: [id], onDelete: SetNull)
  participants MeetingParticipant[]

  @@index([userId])
  @@index([mentorId])
  @@index([startTime])
}

model MeetingParticipant {
  id        String @id @default(uuid())
  meetingId String @map("meeting_id")
  email     String

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, email])
  @@map("meeting_participants")
}

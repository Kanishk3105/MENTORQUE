# Optional overrides for `docker compose up`. Copy to `.env` in the repo
# root if you want non-default values; every variable has a sane default
# baked into docker-compose.yml already.

JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@mentorque.dev
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Admin User
SEED_PASSWORD=password123

# Optional — the recommendation engine works fine without these (falls
# back to deterministic scoring / hashed embeddings)
HF_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
